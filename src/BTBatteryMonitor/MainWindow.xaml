<Window x:Class="BTBatteryMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BTBatteryMonitor.ViewModels"
        mc:Ignorable="d"
        Title="BTBatteryMonitor"
        Width="210"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- スリム・ダーク調 MenuItem スタイル（左側の白帯ガターを完全排除） -->
        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#EDEDF0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid>
                            <Border x:Name="ItemBorder"
                                    Background="Transparent"
                                    CornerRadius="4"
                                    Margin="2,1"
                                    Padding="6,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- チェックマーク列 -->
                                        <ColumnDefinition Width="18" />
                                        <!-- ヘッダーテキスト列 -->
                                        <ColumnDefinition Width="*" />
                                        <!-- サブメニュー矢印列 -->
                                        <ColumnDefinition Width="14" />
                                    </Grid.ColumnDefinitions>

                                    <!-- チェックマーク（Segoe Fluent Icons / MDL2: ✓） -->
                                    <TextBlock x:Name="CheckGlyph"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="#60CDFF"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Visibility="Collapsed" />

                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />

                                    <!-- サブメニュー親用 右矢印（▶） -->
                                    <TextBlock x:Name="SubmenuArrow"
                                               Grid.Column="2"
                                               Text="&#xE76C;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9"
                                               Foreground="#888899"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <!-- サブメニュー展開用 Popup -->
                            <Popup x:Name="SubMenuPopup"
                                   AllowsTransparency="True"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#E61E1E22"
                                        BorderBrush="#38FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="2,3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Opacity="0.4" Direction="270" ShadowDepth="2" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#383842" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#666666" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セパレータースタイル（薄い境界線） -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Rectangle Height="1" Fill="#28FFFFFF" Margin="4,2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- コンテキストメニュースタイル（本体と統一された角丸・半透明ダーク） -->
        <Style TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#E61E1E22" />
            <Setter Property="BorderBrush" Value="#38FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.4" Direction="270" ShadowDepth="2" Color="#000000" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 英語表記コンテキストメニュー（手動更新 Refresh を追加） -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Refresh" Click="MenuItem_Refresh_Click" />
            <Separator />
            <MenuItem x:Name="MenuWidgetColor" Header="Widget Color">
                <MenuItem Header="Default Dark (#1E1E22)" Click="MenuColor_Click" Tag="#1E1E22" />
                <MenuItem Header="Pure Black (#000000)" Click="MenuColor_Click" Tag="#000000" />
                <MenuItem Header="Deep Navy (#0F172A)" Click="MenuColor_Click" Tag="#0F172A" />
                <MenuItem Header="Slate Gray (#27272A)" Click="MenuColor_Click" Tag="#27272A" />
                <MenuItem Header="Deep Wine (#200B17)" Click="MenuColor_Click" Tag="#200B17" />
                <Separator />
                <MenuItem Header="🎨 Color Palette..." Click="MenuCustomColor_Click" />
            </MenuItem>
            <MenuItem x:Name="MenuWidgetOpacity" Header="Widget Opacity">
                <MenuItem Header="100% (Solid)" Click="MenuOpacity_Click" Tag="1.0" />
                <MenuItem Header="85% (Default)" Click="MenuOpacity_Click" Tag="0.85" />
                <MenuItem Header="65% (Translucent)" Click="MenuOpacity_Click" Tag="0.65" />
                <MenuItem Header="45% (Clear)" Click="MenuOpacity_Click" Tag="0.45" />
                <MenuItem Header="25% (Glass)" Click="MenuOpacity_Click" Tag="0.25" />
            </MenuItem>
            <Separator />
            <MenuItem x:Name="MenuAlwaysOnTop" Header="Always on Top" IsCheckable="True" IsChecked="True" Click="MenuItem_AlwaysOnTop_Click" />
            <MenuItem x:Name="MenuLaunchAtStartup" Header="Launch at Startup" IsCheckable="True" Click="MenuItem_LaunchAtStartup_Click" />
            <Separator />
            <MenuItem Header="Exit" Click="MenuItem_Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <!-- ウィジェット本体カード（半透明・角丸・極小余白） -->
    <Border x:Name="MainCardBorder"
            Margin="5"
            Background="#D81E1E22"
            CornerRadius="7"
            BorderBrush="#38FFFFFF"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect BlurRadius="7" Opacity="0.35" Direction="270" ShadowDepth="2" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="7,4">
            <!-- ヘッダー -->
            <Grid Margin="1,0,1,2">
                <TextBlock Text="Bluetooth Devices"
                           FontSize="8.5"
                           FontWeight="SemiBold"
                           Foreground="#777788"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- デバイスが0件または検索中のステータスメッセージ -->
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="9.5"
                       Foreground="#888899"
                       HorizontalAlignment="Center"
                       Margin="0,3">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDevices}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- デバイス一覧（実機データバインディング） -->
            <ItemsControl ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="18" Margin="0">
                            <Grid.ColumnDefinitions>
                                <!-- 種別アイコン -->
                                <ColumnDefinition Width="18" />
                                <!-- デバイス名 -->
                                <ColumnDefinition Width="*" />
                                <!-- 横向き電池アイコン -->
                                <ColumnDefinition Width="Auto" />
                                <!-- 残量数値(%) -->
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <!-- 種別アイコン (Windows標準アイコンフォント + スカイブルー) -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DeviceTypeIcon}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="#60CDFF"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left" />

                            <!-- デバイス名 -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="10.5"
                                       Foreground="#EDEDED"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"
                                       Margin="1,0,4,0" />

                            <!-- 横向き電池アイコン（スリムベクター構成: 18px） -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0">
                                <!-- 電池外枠 -->
                                <Border Width="18"
                                        Height="9"
                                        CornerRadius="1.8"
                                        BorderThickness="1"
                                        BorderBrush="#8E8E93"
                                        Background="#22FFFFFF"
                                        SnapsToDevicePixels="True">
                                    <!-- 電池内部残量バー -->
                                    <Border Width="{Binding FillWidth}"
                                            Height="5"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            CornerRadius="0.6"
                                            Background="{Binding LevelBrushColor}"
                                            Margin="1,0,0,0"
                                            SnapsToDevicePixels="True" />
                                </Border>
                                <!-- 電池端子突起 -->
                                <Border Width="1.5"
                                        Height="3.8"
                                        CornerRadius="0,0.6,0.6,0"
                                        Background="#8E8E93"
                                        VerticalAlignment="Center"
                                        Margin="-0.2,0,0,0"
                                        SnapsToDevicePixels="True" />
                            </StackPanel>

                            <!-- バッテリー数値(%) -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding BatteryText}"
                                       FontSize="9.5"
                                       FontWeight="Medium"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
